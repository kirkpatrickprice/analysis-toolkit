                                "mkdocs",
                                "serve"
                        ],
                        "group": "build",
                        "problemMatcher": [],
                        "isBackground": true,
                        "presentation": {
                                "echo": true,
                                "reveal": "always",
                                "focus": false,
                                "panel": "new"
                        },
                        "runOptions": {
                                "runOn": "folderOpen"
                        }
                }
    ]
}