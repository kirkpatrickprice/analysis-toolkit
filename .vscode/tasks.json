{
    "version": "2.0.0",
    "tasks": [
        {
        "label": "uv_sync",
        "type": "shell",
        "command": "uv",
        "args": [
                "sync"
        ],
        },
        {
                        "label": "uv_mkdocs_serve",
                        "type": "shell",
                        "command": "uv",
                        "args": [
